# =============================================================
# SRS ADS-B Receiver - Site Configuration
# =============================================================
# Copy this file to config/site.conf and fill in your values:
#   cp config/site.conf.example config/site.conf
#   nano config/site.conf
#
# Required fields: SITE_NAME, LAT, LON, ALT_M, FR24_KEY
# Everything else is detected or auto-generated by the installer.
# =============================================================

# ── Site identity ─────────────────────────────────────────────
# A short name for this receiver — letters, numbers, hyphens and
# underscores only, no spaces. Shown on the ADSB Exchange MLAT map.
SITE_NAME="My-ADSB-Site"

# ── Location ──────────────────────────────────────────────────
# Decimal degrees, WGS84. Negative = South or West.
# Tip: right-click your antenna location in Google Maps to copy coords.
LAT=-44.70000
LON=169.13000

# Altitude of your ANTENNA above sea level in metres.
# (Not your house — the antenna itself.)
ALT_M=350

# ── RTL-SDR ───────────────────────────────────────────────────
# Gain in dB. 40 is a safe starting point for most installs.
# Lower if you're getting lots of errors; raise if range is poor.
RECEIVER_GAIN=40

# Serial number of your RTL-SDR dongle.
# Leave blank — the installer detects and writes this automatically.
# If you already know your dongle serial, enter it here to skip detection.
RTLSDR_SERIAL=

# ── Flightradar24 ─────────────────────────────────────────────
# Your FR24 sharing key (16 characters).
# - Existing key: find it at https://www.flightradar24.com/account/feeds
#   or from a working install: sudo cat /etc/fr24feed.ini | grep fr24key
# - New key: sign up at https://www.flightradar24.com/share-your-data
#   The signup gives you a key — enter it here before running install.sh.
# REQUIRED — install will not proceed without this.
FR24_KEY=

# ── ADS-B Exchange ────────────────────────────────────────────
# Your ADSB Exchange feeder UUID.
# Leave blank — the installer generates one and saves it here automatically.
# If re-deploying an existing site, paste your previous UUID here to keep
# your feed history and stats continuous.
ADSBX_UUID=
