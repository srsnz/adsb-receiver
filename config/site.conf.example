# Site identity
SITE_NAME="My ADS-B Site"

# Location (decimal degrees, WGS84)
LAT=-44.700
LON=169.130
ALT_M=350

# RTL-SDR gain (0–49.6, or "auto")
RECEIVER_GAIN=40

# RTL-SDR serial number (leave blank if only one dongle)
RTLSDR_SERIAL=

# FR24 sharing key (get from fr24feed signup or existing install)
FR24_KEY=

# ADS-B Exchange UUID (leave blank to auto-generate on first install)
ADSBX_UUID=
